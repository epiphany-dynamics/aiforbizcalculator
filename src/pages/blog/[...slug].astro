---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import NetworkLinks from '../../components/NetworkLinks.astro';
import { buildFAQSchema } from '../../lib/faq-schema';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const editorial = entry.data.editorial;
const sections = editorial ? headings.filter(({ depth }) => depth === 2) : [];

const formattedDate = entry.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
});

const formattedUpdated = entry.data.updated
  ? entry.data.updated.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
  : null;

const pageURL = Astro.url.href;

const authorSchema = {
  '@type': 'Person',
  '@id': 'https://www.wikidata.org/wiki/Q139572015',
  name: 'Patrick Gibbs',
  sameAs: [
    'https://www.wikidata.org/wiki/Q139572015',
    'https://github.com/mcpeezy',
    'https://www.linkedin.com/in/patrick-gibbs-839b7b237',
  ],
};

const publisher = {
  '@type': 'Organization',
  '@id': 'https://www.wikidata.org/wiki/Q139569923',
  name: 'Epiphany Dynamics',
  url: 'https://epiphanydynamics.ai',
  sameAs: [
    'https://www.wikidata.org/wiki/Q139569923',
    'https://github.com/epiphany-dynamics',
    'https://www.linkedin.com/company/epiphanydynamics',
    'https://www.crunchbase.com/organization/epiphany-dynamics',
    'https://epiphanydynamics.ai',
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  author: authorSchema,
  publisher,
  datePublished: entry.data.pubDate.toISOString().split('T')[0],
  dateModified: (entry.data.updated ?? entry.data.pubDate).toISOString().split('T')[0],
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageURL },
  ...(entry.data.image ? { image: new URL(entry.data.image, Astro.site).href } : {}),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://ai4bizcalculator.online' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://ai4bizcalculator.online/blog/' },
    { '@type': 'ListItem', position: 3, name: entry.data.title, item: pageURL },
  ],
};

const faqStructuredData = buildFAQSchema(entry.body);
const schemas = [articleSchema, breadcrumbSchema, ...(faqStructuredData ? [faqStructuredData] : [])];
---

<Base
  title={`${entry.data.seoTitle} - AI for Biz Calculator`}
  description={entry.data.description}
  ogImage={entry.data.image}
  ogImageWidth={entry.data.imageWidth}
  ogImageHeight={entry.data.imageHeight}
  schema={schemas}
  noindex={entry.data.noindex === true}
>
  <Header />
  <article class="pt-24 pb-8 md:pt-28 md:pb-12 max-w-[65ch] mx-auto px-4">
    <header class="mb-8 md:mb-12 border-b border-border pb-8">
      <h1 class="text-3xl md:text-5xl leading-tight mb-4">{entry.data.title}</h1>
      <div class="flex flex-wrap items-center gap-4 text-sm text-muted">
        <time datetime={entry.data.pubDate.toISOString()}>{formattedDate}</time>
        <span>by Patrick Gibbs</span>
        {formattedUpdated && <span>Updated {formattedUpdated}</span>}
      </div>
      {entry.data.image && (
        <figure class="mt-6">
          <img
            src={entry.data.image}
            alt={entry.data.imageAlt ?? entry.data.title}
            width={entry.data.imageWidth}
            height={entry.data.imageHeight}
            class="w-full rounded-xl"
            loading="eager"
          />
        </figure>
      )}
    </header>

    {editorial && (
      <>
        <section class="editorial-takeaways" aria-labelledby="takeaways-heading">
          <p class="editorial-eyebrow">The quick read</p>
          <h2 id="takeaways-heading">Key takeaways</h2>
          <ol>
            {editorial.takeaways.map((takeaway, index) => (
              <li><span aria-hidden="true">0{index + 1}</span><p>{takeaway}</p></li>
            ))}
          </ol>
        </section>
        {sections.length > 0 && (
          <nav class="editorial-contents" aria-label="Article contents">
            <h2>In this article</h2>
            <ol>
              {sections.map(({ slug, text }) => (
                <li><a href={`#${slug}`}>{text}</a></li>
              ))}
            </ol>
          </nav>
        )}
        {editorial.stats && editorial.stats.length > 0 && (
          <section class="editorial-stats" aria-labelledby="stats-heading">
            <h2 id="stats-heading">Figures at a glance</h2>
            <div class="editorial-stat-grid">
              {editorial.stats.map((stat) => (
                <div class="editorial-stat">
                  <strong>{stat.value}</strong>
                  <p>{stat.label}</p>
                  <span>Source: <a href={stat.sourceUrl}>{stat.sourceName}</a> ({stat.sourceDate})</span>
                </div>
              ))}
            </div>
          </section>
        )}
      </>
    )}

    <div class:list={['prose', 'mx-auto', { 'editorial-prose': !!editorial }]}>
      <Content />
    </div>

    {editorial?.methodology && (
      <section class="editorial-methodology" aria-labelledby="methodology-heading">
        <h2 id="methodology-heading">Sources and methodology</h2>
        <p>{editorial.methodology}</p>
        {editorial.verifiedAt && <p class="editorial-verified">Sources verified {editorial.verifiedAt}.</p>}
      </section>
    )}

    <NetworkLinks links={entry.data.networkLinks} />
  </article>
  <Footer />
</Base>
